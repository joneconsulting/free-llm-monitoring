{
  "uid": "free-llm-monitoring",
  "title": "Spring AI · LLM 모니터링 (무료 강의)",
  "tags": [
    "spring-ai",
    "llm"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "요약 — 선택한 기간 기준",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "입력 토큰 (선택 기간)",
      "description": "채팅 모델에 보낸 입력 토큰 합계 — 비용의 원천",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(gen_ai_client_token_usage_total{gen_ai_token_type=\"input\",gen_ai_operation_name=\"chat\"}[$__range]))",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#5FA83C",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "모델 호출 수",
      "description": "ChatModel 호출 횟수 (Tool 호출 시 1요청 = 2회 이상)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(gen_ai_client_operation_seconds_count{gen_ai_operation_name=\"chat\"}[$__range]))",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#5FA83C",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "오류율",
      "description": "error 라벨이 none 이 아닌 호출의 비율",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(gen_ai_client_operation_seconds_count{gen_ai_operation_name=\"chat\",error!=\"none\"}[$__range])) / sum(increase(gen_ai_client_operation_seconds_count{gen_ai_operation_name=\"chat\"}[$__range]))",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#5FA83C",
                "value": null
              },
              {
                "color": "#E0A43A",
                "value": 0.01
              },
              {
                "color": "#D9534F",
                "value": 0.1
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "평균 응답 시간",
      "description": "ChatModel 호출 1회의 평균 소요 시간",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(gen_ai_client_operation_seconds_sum{gen_ai_operation_name=\"chat\"}[$__range])) / sum(increase(gen_ai_client_operation_seconds_count{gen_ai_operation_name=\"chat\"}[$__range]))",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#5FA83C",
                "value": null
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "row",
      "title": "비용과 토큰",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "분당 토큰 사용량",
      "description": "gen_ai.client.token.usage — input / output 토큰",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (gen_ai_token_type) (rate(gen_ai_client_token_usage_total{gen_ai_token_type!=\"total\"}[1m])) * 60",
          "legendFormat": "{{gen_ai_token_type}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "stacking": {
              "mode": "normal"
            },
            "spanNulls": true
          }
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "text",
      "title": "원화 비용 대시보드",
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "options": {
        "mode": "markdown",
        "content": "### 토큰을 원화로 보려면?\n\n왼쪽 토큰 그래프는 **비용의 원천**입니다.\n\n모델별 단가를 곱해 **원화 비용**으로 보여 주는 커스텀 메트릭,\n비용 급증 **알림**, 요청 한 건의 **Span 추적**은\n\n**『Spring 개발자를 위한 실전 LLM 서비스 개발』 섹션 16** 에서\n이 프로젝트를 확장해 직접 만듭니다."
      }
    },
    {
      "id": 9,
      "type": "row",
      "title": "지연 시간",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "모델 응답 p95 / p50",
      "description": "percentiles-histogram 설정이 있어야 보인다",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, gen_ai_request_model) (rate(gen_ai_client_operation_seconds_bucket{gen_ai_operation_name=\"chat\"}[5m])))",
          "legendFormat": "p95 {{gen_ai_request_model}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.50, sum by (le, gen_ai_request_model) (rate(gen_ai_client_operation_seconds_bucket{gen_ai_operation_name=\"chat\"}[5m])))",
          "legendFormat": "p50 {{gen_ai_request_model}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "stacking": {
              "mode": "none"
            },
            "spanNulls": true
          }
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "ChatClient vs ChatModel 평균 시간",
      "description": "두 선의 차이 = 벡터 검색·툴 실행·다중 모델 호출에 쓴 시간",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(spring_ai_chat_client_seconds_sum[5m])) / sum(rate(spring_ai_chat_client_seconds_count[5m]))",
          "legendFormat": "ChatClient (Advisor·Tool 포함)"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(gen_ai_client_operation_seconds_sum{gen_ai_operation_name=\"chat\"}[5m])) / sum(rate(gen_ai_client_operation_seconds_count{gen_ai_operation_name=\"chat\"}[5m]))",
          "legendFormat": "ChatModel (모델 호출 1회)"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "stacking": {
              "mode": "none"
            },
            "spanNulls": true
          }
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "row",
      "title": "RAG · Tool",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "벡터 검색 평균 시간",
      "description": "db.vector.client.operation (query)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(db_vector_client_operation_seconds_sum{db_operation_name=\"query\"}[5m])) / sum(rate(db_vector_client_operation_seconds_count{db_operation_name=\"query\"}[5m]))",
          "legendFormat": "{{db_system}} query"
        }
      ],
      "options": {
        "legend": {
