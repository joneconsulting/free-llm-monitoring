    {
      "id": 14,
      "type": "timeseries",
      "title": "툴 호출 수 (5분)",
      "description": "spring.ai.tool — 툴 이름별",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 24,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (spring_ai_tool_definition_name) (increase(spring_ai_tool_seconds_count[5m]))",
          "legendFormat": "{{spring_ai_tool_definition_name}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
